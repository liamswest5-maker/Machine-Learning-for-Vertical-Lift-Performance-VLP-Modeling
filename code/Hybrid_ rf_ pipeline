"""
Physics-Informed Hybrid Random Forest VLP Pipeline
==================================================
Matches the MEng dissertation methodology (Sections 3.2–3.11):

  Stage 1  ΔP_baseline  = hydrostatic + frictional (homogeneous, no-slip)
  Stage 2  RF predicts residual r = ΔP_measured − ΔP_baseline
  Final    ΔP_hybrid    = ΔP_baseline + RF(residual)

Compared under three validation schemes against:
  - mechanistic baseline alone
  - plain RF (predicts ΔP_measured directly)

Assumptions (Table 3.2 / Section 3.7) — field-representative, not well-calibrated:
  D = 0.0889 m (3.5 in), TVD = 2750 m, ρ_oil = 850 kg/m³, ρ_wat = 1030 kg/m³,
  gas SG = 0.75, μ_mix = 0.003 Pa·s, ε = 0.0457 mm

RF hyperparameters (Section 3.8 / 3.12 grid search):
  n_estimators=400, min_samples_leaf=2, max_features=0.5, random_state=42

Run from repository root:
  python code/hybrid_rf_pipeline.py
"""

from __future__ import annotations

import warnings
from pathlib import Path

import numpy as np
import pandas as pd
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
from sklearn.model_selection import train_test_split

warnings.filterwarnings("ignore")

# -----------------------------------------------------------------------------
# Paths
# -----------------------------------------------------------------------------
BASE_DIR = Path(__file__).resolve().parents[1]
INPUT_PATH = BASE_DIR / "data" / "volve_welldata_raw.csv"
DATA_DIR = BASE_DIR / "data"
FIG_DIR = BASE_DIR / "figures"
DATA_DIR.mkdir(exist_ok=True)
FIG_DIR.mkdir(exist_ok=True)

# -----------------------------------------------------------------------------
# Wells and physical constants (dissertation Section 3.7 / Table 3.2)
# -----------------------------------------------------------------------------
USABLE_WELLS = [
    "15/9-F-1 C",
    "15/9-F-11 H",
    "15/9-F-12 H",
    "15/9-F-14 H",
    "15/9-F-15 D",
]

D = 0.0889          # m  (3.5 in ID)
TVD = 2750.0        # m
RHO_OIL = 850.0     # kg/m³
RHO_WAT = 1030.0    # kg/m³
GAS_SG = 0.75
MU_MIX = 0.003      # Pa·s
EPS = 0.0457e-3     # m  (0.0457 mm commercial steel)
G = 9.81            # m/s²
P_STD = 101325.0    # Pa
T_STD = 288.15      # K  (15 °C)
R_AIR = 287.058     # J/(kg·K)

RF_PARAMS = dict(
    n_estimators=400,
    min_samples_leaf=2,
    max_features=0.5,
    random_state=42,
    n_jobs=-1,
)

PLAIN_FEATURES = [
    "q_oil",
    "q_gas",
    "q_wat",
    "q_liq",
    "WC",
    "GOR",
    "GLR",
    "ln_qliq",
    "ln_qoil",
    "ln_qgas",
    "dT",
    "choke_pct",
    "ON_STREAM_HRS",
]

HYBRID_FEATURES = PLAIN_FEATURES + ["delta_P_baseline"]
TARGET = "delta_P_measured"


def compute_metrics(y_true, y_pred):
    y_true = np.asarray(y_true, dtype=float)
    y_pred = np.asarray(y_pred, dtype=float)
    mask = np.isfinite(y_true) & np.isfinite(y_pred)
    y_true, y_pred = y_true[mask], y_pred[mask]
    if len(y_true) == 0:
        return {"RMSE": np.nan, "MAE": np.nan, "MAPE": np.nan, "R2": np.nan, "n": 0}
    rmse = float(np.sqrt(mean_squared_error(y_true, y_pred)))
    mae = float(mean_absolute_error(y_true, y_pred))
    mape = float(np.mean(np.abs((y_true - y_pred) / np.maximum(np.abs(y_true), 1e-6))) * 100.0)
    r2 = float(r2_score(y_true, y_pred))
    return {"RMSE": rmse, "MAE": mae, "MAPE": mape, "R2": r2, "n": int(len(y_true))}


def swamee_jain(Re, rel_rough):
    Re = np.maximum(Re, 1.0)
    term = rel_rough / 3.7 + 5.74 / np.power(Re, 0.9)
    f = 0.25 / np.square(np.log10(term))
    return np.clip(f, 0.008, 0.1)


def compute_baseline(df):
    """ΔP_baseline = ΔP_hyd + ΔP_fric [bar] — homogeneous no-slip + Swamee-Jain."""
    q_oil_s = df["q_oil"].to_numpy(float) / 86400.0
    q_wat_s = df["q_wat"].to_numpy(float) / 86400.0
    q_gas_s = df["q_gas"].to_numpy(float) / 86400.0

    P_wf = df["AVG_DOWNHOLE_PRESSURE"].to_numpy(float)
    P_wh = df["AVG_WHP_P"].to_numpy(float)
    T_wf = df["AVG_DOWNHOLE_TEMPERATURE"].to_numpy(float)
    T_wh = df["AVG_WHT_P"].to_numpy(float)

    P_avg_bar = 0.5 * (P_wf + P_wh)
    T_avg_K = 0.5 * (T_wf + T_wh) + 273.15

    P_avg_Pa = P_avg_bar * 1e5
    rho_g = (P_avg_Pa * GAS_SG) / (R_AIR * np.maximum(T_avg_K, 1.0))

    q_g_dh = q_gas_s * (P_STD / np.maximum(P_avg_Pa, 1.0)) * (T_avg_K / T_STD)

    q_liq_s = q_oil_s + q_wat_s
    q_tot = q_liq_s + q_g_dh
    f_liq = np.where(q_tot > 0, q_liq_s / q_tot, 1.0)
    f_gas = 1.0 - f_liq

    rho_liq = np.where(
        q_liq_s > 0,
        (q_oil_s * RHO_OIL + q_wat_s * RHO_WAT) / np.maximum(q_liq_s, 1e-12),
        RHO_OIL,
    )
    rho_mix = f_liq * rho_liq + f_gas * rho_g

    A = np.pi / 4.0 * D ** 2
    v_mix = q_tot / A

    Re = (rho_mix * v_mix * D) / MU_MIX
    f = swamee_jain(Re, EPS / D)

    dP_hyd_bar = (rho_mix * G * TVD) / 1e5
    dP_fric_bar = (f * (TVD / D) * (rho_mix * v_mix ** 2 / 2.0)) / 1e5

    return pd.Series(dP_hyd_bar + dP_fric_bar, index=df.index, name="delta_P_baseline")


def prepare_data():
    df = pd.read_csv(INPUT_PATH)
    op = df[df["WELL_TYPE"] == "OP"].copy()
    op = op[op["Wellbore name"].isin(USABLE_WELLS)].copy()

    numeric = [
        "ON_STREAM_HRS", "AVG_DOWNHOLE_PRESSURE", "AVG_DOWNHOLE_TEMPERATURE",
        "AVG_DP_TUBING", "AVG_CHOKE_SIZE_P", "AVG_WHP_P", "AVG_WHT_P",
        "BORE_OIL_VOL", "BORE_GAS_VOL", "BORE_WAT_VOL",
    ]
    for c in numeric:
        op[c] = pd.to_numeric(op[c], errors="coerce")

    mask = (
        (op["AVG_DOWNHOLE_PRESSURE"] > op["AVG_WHP_P"])
        & (op["AVG_WHP_P"] > 0)
        & (op["ON_STREAM_HRS"] > 0)
        & (op["BORE_OIL_VOL"] > 0)
        & op["AVG_DOWNHOLE_PRESSURE"].notna()
        & op["AVG_WHP_P"].notna()
    )
    clean = op[mask].copy()
    clean["Date of Production"] = pd.to_datetime(
        clean["Date of Production"], format="mixed", dayfirst=False
    )
    clean = clean.sort_values(["Wellbore name", "Date of Production"]).reset_index(drop=True)

    hrs = clean["ON_STREAM_HRS"].clip(lower=0.1)
    clean["q_oil"] = clean["BORE_OIL_VOL"] * 24.0 / hrs
    clean["q_gas"] = clean["BORE_GAS_VOL"] * 24.0 / hrs
    clean["q_wat"] = clean["BORE_WAT_VOL"].fillna(0.0) * 24.0 / hrs

    clean["q_liq"] = clean["q_oil"] + clean["q_wat"]
    clean["WC"] = np.where(clean["q_liq"] > 0, clean["q_wat"] / clean["q_liq"], 0.0)
    clean["GOR"] = np.where(clean["q_oil"] > 0, clean["q_gas"] / clean["q_oil"], 0.0)
    clean["GLR"] = np.where(clean["q_liq"] > 0, clean["q_gas"] / clean["q_liq"], 0.0)

    clean["ln_qliq"] = np.log(np.maximum(clean["q_liq"], 1e-6))
    clean["ln_qoil"] = np.log(np.maximum(clean["q_oil"], 1e-6))
    clean["ln_qgas"] = np.log(np.maximum(clean["q_gas"], 1e-6))
    clean["dT"] = clean["AVG_DOWNHOLE_TEMPERATURE"] - clean["AVG_WHT_P"]
    clean["choke_pct"] = clean["AVG_CHOKE_SIZE_P"].fillna(0.0)

    clean["delta_P_measured"] = clean["AVG_DOWNHOLE_PRESSURE"] - clean["AVG_WHP_P"]

    # Steady-state filter: 7-day rolling CV of liquid rate (Section 3.6)
    clean["cv_qliq"] = (
        clean.groupby("Wellbore name")["q_liq"]
        .transform(
            lambda s: s.rolling(7, min_periods=3).std()
            / s.rolling(7, min_periods=3).mean()
        )
    )
    clean = clean[clean["cv_qliq"].isna() | (clean["cv_qliq"] <= 0.25)].copy()

    clean = clean.dropna(
        subset=[
            "delta_P_measured", "q_oil", "q_gas", "q_wat",
            "AVG_DOWNHOLE_TEMPERATURE", "AVG_WHT_P",
        ]
    )

    clean["delta_P_baseline"] = compute_baseline(clean)
    clean["residual"] = clean["delta_P_measured"] - clean["delta_P_baseline"]
    clean["well_short"] = clean["Wellbore name"].str.replace("15/9-", "", regex=False)

    return clean.reset_index(drop=True)


def fit_plain_and_hybrid(train, test):
    plain = RandomForestRegressor(**RF_PARAMS)
    plain.fit(train[PLAIN_FEATURES], train[TARGET])
    pred_plain = plain.predict(test[PLAIN_FEATURES])

    hybrid = RandomForestRegressor(**RF_PARAMS)
    hybrid.fit(train[HYBRID_FEATURES], train["residual"])
    pred_resid = hybrid.predict(test[HYBRID_FEATURES])
    pred_hybrid = test["delta_P_baseline"].to_numpy(float) + pred_resid

    return pred_plain, pred_hybrid, plain, hybrid


def run_pooled(df, test_size=0.20, seed=42):
    train, test = train_test_split(df, test_size=test_size, random_state=seed)
    pred_plain, pred_hybrid, _, _ = fit_plain_and_hybrid(train, test)
    rows = []
    for name, pred in [
        ("Mechanistic baseline", test["delta_P_baseline"]),
        ("Plain RF", pred_plain),
        ("Hybrid RF", pred_hybrid),
    ]:
        m = compute_metrics(test[TARGET], pred)
        rows.append({"strategy": "pooled_random_80_20", "test_well": "ALL", **m, "model": name})
    return pd.DataFrame(rows)


def run_lowo(df):
    rows = []
    for well in df["Wellbore name"].unique():
        train = df[df["Wellbore name"] != well]
        test = df[df["Wellbore name"] == well]
        if len(test) < 5 or len(train) < 50:
            continue
        pred_plain, pred_hybrid, _, _ = fit_plain_and_hybrid(train, test)
        for name, pred in [
            ("Mechanistic baseline", test["delta_P_baseline"]),
            ("Plain RF", pred_plain),
            ("Hybrid RF", pred_hybrid),
        ]:
            m = compute_metrics(test[TARGET], pred)
            rows.append({
                "strategy": "LOWO",
                "test_well": well.replace("15/9-", ""),
                **m,
                "model": name,
            })
    return pd.DataFrame(rows)


def run_chronological(df, train_frac=0.70):
    d = df.sort_values("Date of Production").reset_index(drop=True)
    cut = int(len(d) * train_frac)
    train, test = d.iloc[:cut], d.iloc[cut:]
    pred_plain, pred_hybrid, _, _ = fit_plain_and_hybrid(train, test)
    rows = []
    for name, pred in [
        ("Mechanistic baseline", test["delta_P_baseline"]),
        ("Plain RF", pred_plain),
        ("Hybrid RF", pred_hybrid),
    ]:
        m = compute_metrics(test[TARGET], pred)
        rows.append({
            "strategy": "chronological_70_30",
            "test_well": "ALL",
            **m,
            "model": name,
        })
    return pd.DataFrame(rows)


def run_pooled_per_well(df, test_size=0.20, seed=42):
    train, test = train_test_split(df, test_size=test_size, random_state=seed)
    pred_plain, pred_hybrid, _, _ = fit_plain_and_hybrid(train, test)
    test = test.copy()
    test["pred_plain"] = pred_plain
    test["pred_hybrid"] = pred_hybrid
    rows = []
    for well, g in test.groupby("Wellbore name"):
        for name, col in [
            ("Plain RF", "pred_plain"),
            ("Hybrid RF", "pred_hybrid"),
            ("Mechanistic baseline", "delta_P_baseline"),
        ]:
            m = compute_metrics(g[TARGET], g[col])
            rows.append({
                "strategy": "pooled_per_well",
                "test_well": well.replace("15/9-", ""),
                **m,
                "model": name,
            })
    return pd.DataFrame(rows)


def feature_importance(df):
    train, _ = train_test_split(df, test_size=0.2, random_state=42)
    plain = RandomForestRegressor(**RF_PARAMS)
    plain.fit(train[PLAIN_FEATURES], train[TARGET])
    hybrid = RandomForestRegressor(**RF_PARAMS)
    hybrid.fit(train[HYBRID_FEATURES], train["residual"])
    rows = []
    for feat, imp in zip(PLAIN_FEATURES, plain.feature_importances_):
        rows.append({"model": "Plain RF", "feature": feat, "importance": float(imp)})
    for feat, imp in zip(HYBRID_FEATURES, hybrid.feature_importances_):
        rows.append({"model": "Hybrid RF", "feature": feat, "importance": float(imp)})
    return pd.DataFrame(rows)


def worked_example_f1c(df):
    target_date = pd.Timestamp("2015-10-15")
    rec = df[
        (df["Wellbore name"] == "15/9-F-1 C")
        & (df["Date of Production"].dt.normalize() == target_date)
    ]
    if rec.empty:
        print("\n[Worked example] F-1C 15 Oct 2015 not present after filtering — skip.")
        return
    r = rec.iloc[0]
    print("\n" + "=" * 70)
    print("WORKED EXAMPLE — F-1C, 15 October 2015 (Section 3.11)")
    print("=" * 70)
    print(f"  ON_STREAM_HRS          = {r['ON_STREAM_HRS']:.1f} h")
    print(f"  Pwf / Pwh              = {r['AVG_DOWNHOLE_PRESSURE']:.3f} / {r['AVG_WHP_P']:.3f} bar")
    print(f"  q_oil / q_gas / q_wat  = {r['q_oil']:.1f} / {r['q_gas']:.1f} / {r['q_wat']:.1f} sm³/d")
    print(f"  ΔP_measured            = {r['delta_P_measured']:.3f} bar")
    print(f"  ΔP_baseline            = {r['delta_P_baseline']:.3f} bar")
    print(f"  residual (true)        = {r['residual']:.3f} bar")

    train = df[df["Wellbore name"] != "15/9-F-1 C"]
    test = rec
    pred_plain, pred_hybrid, _, _ = fit_plain_and_hybrid(train, test)
    print(f"  Plain RF prediction    = {pred_plain[0]:.3f} bar")
    print(f"  Hybrid RF prediction   = {pred_hybrid[0]:.3f} bar")
    print(f"  Hybrid error           = {pred_hybrid[0] - r['delta_P_measured']:.3f} bar")


def main():
    print("=" * 78)
    print("PHYSICS-INFORMED HYBRID RANDOM FOREST VLP PIPELINE")
    print("Matching MEng dissertation Sections 3.2–3.11")
    print("=" * 78)
    print(
        f"Baseline: D={D} m, TVD={TVD} m, ρ_oil={RHO_OIL}, ρ_wat={RHO_WAT}, "
        f"gas SG={GAS_SG}, μ={MU_MIX} Pa·s"
    )
    print(f"RF params: {RF_PARAMS}")

    df = prepare_data()
    print(f"\nModel-ready records: {len(df)}")
    print(df.groupby("Wellbore name").size().to_string())
    print(
        f"\nMean measured ΔP = {df['delta_P_measured'].mean():.1f} bar  "
        f"(std {df['delta_P_measured'].std():.1f})"
    )
    print(
        f"Mean baseline ΔP = {df['delta_P_baseline'].mean():.1f} bar  "
        f"(std {df['delta_P_baseline'].std():.1f})"
    )

    df.to_csv(DATA_DIR / "hybrid_model_ready.csv", index=False)

    base_metrics = compute_metrics(df[TARGET], df["delta_P_baseline"])
    print(f"\nBaseline overall: R²={base_metrics['R2']:.3f}  RMSE={base_metrics['RMSE']:.1f} bar")

    print("\n--- Pooled random 80/20 ---")
    pooled = run_pooled(df)
    print(pooled.round(4).to_string(index=False))

    print("\n--- Leave-One-Well-Out ---")
    lowo = run_lowo(df)
    print(lowo.round(4).to_string(index=False))
    mean_lowo = lowo.groupby("model")["R2"].mean()
    print("\nMean LOWO R²:")
    print(mean_lowo.round(4).to_string())

    print("\n--- Chronological 70/30 ---")
    chrono = run_chronological(df)
    print(chrono.round(4).to_string(index=False))

    print("\n--- Pooled per-well breakdown ---")
    per_well = run_pooled_per_well(df)
    print(per_well.round(4).to_string(index=False))

    print("\n--- Feature importance ---")
    fi = feature_importance(df)
    for model in ["Plain RF", "Hybrid RF"]:
        print(f"\n{model}:")
        sub = fi[fi["model"] == model].sort_values("importance", ascending=False)
        print(sub.head(8).round(4).to_string(index=False))

    pooled.to_csv(DATA_DIR / "hybrid_pooled_results.csv", index=False)
    lowo.to_csv(DATA_DIR / "hybrid_lowo_results.csv", index=False)
    chrono.to_csv(DATA_DIR / "hybrid_chronological_results.csv", index=False)
    per_well.to_csv(DATA_DIR / "hybrid_pooled_per_well.csv", index=False)
    fi.to_csv(DATA_DIR / "hybrid_feature_importance.csv", index=False)
    all_res = pd.concat([pooled, lowo, chrono], ignore_index=True)
    all_res.to_csv(DATA_DIR / "hybrid_all_results.csv", index=False)

    worked_example_f1c(df)

    print("\n" + "=" * 78)
    print("Saved CSVs to data/: hybrid_model_ready.csv, hybrid_*_results.csv,")
    print("  hybrid_feature_importance.csv, hybrid_all_results.csv")
    print("=" * 78)


if __name__ == "__main__":
    main()
