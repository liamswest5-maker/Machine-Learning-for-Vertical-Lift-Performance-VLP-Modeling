"""
Hybrid Poettmann-Carpenter + Random Forest VLP Pipeline

Purpose
-------
Adds a traditional Poettmann-Carpenter (PC) baseline to the existing VLP
Random Forest project and trains Random Forest to predict the PC residual:

    residual = measured_delta_P - PC_delta_P
    hybrid_delta_P = PC_delta_P + RF(residual)

The plain RF model is retained as a control. All three models are evaluated
under the same pooled random, leave-one-well-out, and chronological splits.

IMPORTANT ASSUMPTIONS
---------------------
The public Volve production CSV does not provide well-specific tubing ID,
completion geometry, fluid PVT tables, or gas specific gravity. Therefore the
PC calculation below uses explicit representative assumptions. These are
parameters of the benchmark, not measured Volve completion values. Replace
them with documented well-specific values before claiming a field-calibrated
PC comparison.

The PC implementation follows the homogeneous/no-slip pressure-gradient form
and uses the Guo-Ghalambor approximation for the original PC two-phase
friction-factor chart. This is a numerical implementation of the traditional
PC method, not a claim that Random Forest or PC itself was invented here.
"""

from pathlib import Path
import warnings
import numpy as np
import pandas as pd
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score
from sklearn.model_selection import train_test_split

warnings.filterwarnings('ignore')

# -----------------------------------------------------------------------------
# Paths and constants
# -----------------------------------------------------------------------------
BASE_DIR = Path(__file__).resolve().parents[1]
INPUT_PATH = BASE_DIR / 'data' / 'volve_welldata_raw.csv'
DATA_DIR = BASE_DIR / 'data'
FIG_DIR = BASE_DIR / 'figures'
DATA_DIR.mkdir(exist_ok=True)
FIG_DIR.mkdir(exist_ok=True)

BAR_TO_PSIA = 14.5037738
M_TO_FT = 3.280839895
M3_TO_STB = 6.28981077
M3_TO_SCF = 35.31466672

USABLE_WELLS = [
    '15/9-F-1 C', '15/9-F-11 H', '15/9-F-12 H',
    '15/9-F-14 H', '15/9-F-15 D'
]

# Explicitly assumed because these are not in the public production CSV.
PC_TUBING_ID_IN = 4.892
PC_DEPTH_M = 3100.0
PC_API = 28.0
PC_GAS_SG = 0.65
PC_WATER_SG = 1.03
PC_BW = 1.00
PC_SEGMENTS = 40

# Same RF configuration is used for direct and residual learning so that the
# comparison focuses on target formulation rather than a different algorithm.
RF_PARAMS = dict(
    n_estimators=400,
    min_samples_leaf=2,
    max_features='sqrt',
    random_state=42,
    n_jobs=-1,
)

PLAIN_FEATURES = [
    'q_oil', 'q_gas', 'q_wat', 'q_liq', 'WC', 'GOR',
    'AVG_WHP_P', 'AVG_WHT_P', 'AVG_DOWNHOLE_TEMPERATURE',
    'AVG_CHOKE_SIZE_P', 'ON_STREAM_HRS',
    'log_q_liq', 'log_q_oil', 'log_q_gas', 'GLR', 'dT'
]

# Hybrid RF receives the same measured/derived predictors plus the independent
# PC baseline. The baseline itself is a deterministic function of observed
# operating inputs and stated assumptions; it is not calculated from Pwf.
HYBRID_FEATURES = PLAIN_FEATURES + ['PC_delta_P']
TARGET = 'delta_P'


def short_well(name):
    return name.replace('15/9-', '')


# -----------------------------------------------------------------------------
# Poettmann-Carpenter support functions
# -----------------------------------------------------------------------------
def oil_specific_gravity(api):
    return 141.5 / (api + 131.5)


def standing_rs(p_psia, t_f, api=PC_API, gas_sg=PC_GAS_SG):
    """Standing solution-gas-ratio estimate, Rs in scf/STB."""
    p = np.maximum(p_psia, 14.7)
    term = (p / 18.0) * 10.0 ** (0.0125 * api - 0.00091 * t_f)
    return gas_sg * np.maximum(term, 1e-12) ** 1.2048


def standing_bo(rs, t_f, api=PC_API, gas_sg=PC_GAS_SG):
    """Standing oil FVF estimate, Bo in rb/STB."""
    go = oil_specific_gravity(api)
    inner = rs * np.sqrt(gas_sg / go) + 1.25 * t_f
    return 0.9759 + 0.00012 * np.maximum(inner, 1e-12) ** 1.2


def papay_z(p_psia, t_r, gas_sg=PC_GAS_SG):
    """Papay-style z-factor approximation used only for the PC benchmark."""
    tpc = 168.0 + 325.0 * gas_sg - 12.5 * gas_sg ** 2
    ppc = 677.0 + 15.0 * gas_sg - 37.5 * gas_sg ** 2
    tpr = np.maximum(t_r, 1.0) / tpc
    ppr = np.maximum(p_psia, 14.7) / ppc
    z = 1.0 - 3.53 * ppr * np.exp(-2.26 * tpr) + 0.274 * ppr ** 2 * np.exp(-1.878 * tpr)
    return np.clip(z, 0.20, 1.50)


def pc_pressure_drop_batch(data, depth_m=PC_DEPTH_M, tubing_id_in=PC_TUBING_ID_IN,
                           api=PC_API, gas_sg=PC_GAS_SG, water_sg=PC_WATER_SG,
                           bw=PC_BW, nseg=PC_SEGMENTS):
    """Vectorized PC pressure traverse; measured downhole pressure is not used."""
    qo = np.maximum(data.q_oil.to_numpy(float) * M3_TO_STB, 1e-9)
    qw = np.maximum(data.q_wat.to_numpy(float) * M3_TO_STB, 0.0)
    qg = np.maximum(data.q_gas.to_numpy(float) * M3_TO_SCF, 0.0)
    gor = qg / qo
    wor = qw / qo
    p = np.maximum(data.AVG_WHP_P.to_numpy(float) * BAR_TO_PSIA, 14.7)
    t_wh_f = data.AVG_WHT_P.to_numpy(float) * 9.0 / 5.0 + 32.0
    t_bh_f = data.AVG_DOWNHOLE_TEMPERATURE.to_numpy(float) * 9.0 / 5.0 + 32.0
    D = tubing_id_in / 12.0
    gamma_o = oil_specific_gravity(api)
    M = 350.17 * (gamma_o + wor * water_sg) + 0.0765 * gor * gas_sg
    D_rho_v = 1.4737e-5 * M * qo / D
    f_2f = 10.0 ** (1.444 - 2.5 * np.log10(np.maximum(D_rho_v, 1e-12)))
    dh = depth_m * M_TO_FT / nseg
    for i in range(nseg):
        frac = (i + 0.5) / nseg
        t_f = t_wh_f + (t_bh_f - t_wh_f) * frac
        t_r = t_f + 459.67
        rs = standing_rs(p, t_f, api, gas_sg)
        bo = standing_bo(rs, t_f, api, gas_sg)
        z = papay_z(p, t_r, gas_sg)
        free_gas = np.maximum(gor - rs, 0.0)
        vm = 5.615 * (bo + wor * bw) + free_gas * (14.7 / p) * (t_r / 520.0) * z
        rho = M / np.maximum(vm, 1e-12)
        k = f_2f * qo ** 2 * M ** 2 / (7.4137e10 * D ** 5)
        grad = (rho + k / np.maximum(rho, 1e-12)) / 144.0
        p_pred = p + grad * dh
        p_mid = 0.5 * (p + p_pred)
        rs = standing_rs(p_mid, t_f, api, gas_sg)
        bo = standing_bo(rs, t_f, api, gas_sg)
        z = papay_z(p_mid, t_r, gas_sg)
        free_gas = np.maximum(gor - rs, 0.0)
        vm = 5.615 * (bo + wor * bw) + free_gas * (14.7 / p_mid) * (t_r / 520.0) * z
        rho = M / np.maximum(vm, 1e-12)
        k = f_2f * qo ** 2 * M ** 2 / (7.4137e10 * D ** 5)
        grad = (rho + k / np.maximum(rho, 1e-12)) / 144.0
        p = p + grad * dh
    return p / BAR_TO_PSIA - data.AVG_WHP_P.to_numpy(float)


# -----------------------------------------------------------------------------
# Data preparation
# -----------------------------------------------------------------------------
def prepare_data():
    df = pd.read_csv(INPUT_PATH)
    op = df[df['WELL_TYPE'] == 'OP'].copy()
    op = op[op['Wellbore name'].isin(USABLE_WELLS)].copy()

    numeric = [
        'ON_STREAM_HRS', 'AVG_DOWNHOLE_PRESSURE', 'AVG_DOWNHOLE_TEMPERATURE',
        'AVG_DP_TUBING', 'AVG_CHOKE_SIZE_P', 'AVG_WHP_P', 'AVG_WHT_P',
        'BORE_OIL_VOL', 'BORE_GAS_VOL', 'BORE_WAT_VOL'
    ]
    for c in numeric:
        op[c] = pd.to_numeric(op[c], errors='coerce')

    mask = (
        (op['AVG_DOWNHOLE_PRESSURE'] > 0) &
        (op['AVG_WHP_P'] > 0) &
        (op['ON_STREAM_HRS'] > 0) &
        (op['BORE_OIL_VOL'] > 0) &
        op['AVG_DP_TUBING'].notna() &
        (op['AVG_DP_TUBING'] > 0)
    )
    clean = op[mask].copy()
    clean['Date of Production'] = pd.to_datetime(clean['Date of Production'], format='mixed')
    clean = clean.sort_values(['Wellbore name', 'Date of Production']).reset_index(drop=True)

    clean['q_oil'] = clean['BORE_OIL_VOL'] * 24.0 / clean['ON_STREAM_HRS']
    clean['q_gas'] = clean['BORE_GAS_VOL'] * 24.0 / clean['ON_STREAM_HRS']
    clean['q_wat'] = clean['BORE_WAT_VOL'] * 24.0 / clean['ON_STREAM_HRS']
    clean['q_liq'] = clean['q_oil'] + clean['q_wat']
    clean['WC'] = clean['q_wat'] / clean['q_liq'].replace(0, np.nan)
    clean['GOR'] = clean['q_gas'] / clean['q_oil'].replace(0, np.nan)
    clean['GLR'] = clean['q_gas'] / clean['q_liq'].replace(0, np.nan)
    clean['log_q_liq'] = np.log1p(clean['q_liq'])
    clean['log_q_oil'] = np.log1p(clean['q_oil'])
    clean['log_q_gas'] = np.log1p(clean['q_gas'])
    clean['dT'] = clean['AVG_DOWNHOLE_TEMPERATURE'] - clean['AVG_WHT_P']
    clean['delta_P'] = clean['AVG_DOWNHOLE_PRESSURE'] - clean['AVG_WHP_P']

    clean = clean[
        (clean['WC'] >= 0) & (clean['WC'] <= 1) &
        (clean['GOR'] > 0) & (clean['GOR'] < 5000) &
        (clean['q_liq'] > 0) & (clean['delta_P'] > 0)
    ].copy()

    g = clean.groupby('Wellbore name', group_keys=False)
    clean['roll_std_q'] = g['q_liq'].rolling(7, min_periods=3).std().reset_index(level=0, drop=True)
    clean['roll_mean_q'] = g['q_liq'].rolling(7, min_periods=3).mean().reset_index(level=0, drop=True)
    clean['roll_std_dP'] = g['delta_P'].rolling(7, min_periods=3).std().reset_index(level=0, drop=True)
    clean['cv_q'] = clean['roll_std_q'] / clean['roll_mean_q'].replace(0, np.nan)
    steady = clean[
        (clean['cv_q'] < 0.35) &
        (clean['roll_std_dP'] < 30.0) &
        clean['cv_q'].notna()
    ].copy()

    # PC baseline: no measured downhole pressure is passed into the function.
    print('Computing Poettmann-Carpenter baseline...')
    steady['PC_delta_P'] = pc_pressure_drop_batch(steady)
    steady['PC_residual'] = steady['delta_P'] - steady['PC_delta_P']

    cols = ['Wellbore name', 'Date of Production'] + PLAIN_FEATURES + ['PC_delta_P', 'PC_residual', TARGET]
    d = steady[cols].replace([np.inf, -np.inf], np.nan).dropna().reset_index(drop=True)
    return d


# -----------------------------------------------------------------------------
# Metrics and model runners
# -----------------------------------------------------------------------------
def metrics(y_true, y_pred):
    y_true = np.asarray(y_true)
    y_pred = np.asarray(y_pred)
    return {
        'RMSE': np.sqrt(mean_squared_error(y_true, y_pred)),
        'MAE': mean_absolute_error(y_true, y_pred),
        'MAPE': np.mean(np.abs((y_true - y_pred) / y_true)) * 100.0,
        'R2': r2_score(y_true, y_pred),
    }


def fit_models(train_df, test_df):
    # Plain RF: direct prediction of measured pressure drop.
    plain = RandomForestRegressor(**RF_PARAMS)
    plain.fit(train_df[PLAIN_FEATURES], train_df[TARGET])
    plain_pred = plain.predict(test_df[PLAIN_FEATURES])

    # Hybrid RF: learn the PC residual, then add it back to the PC baseline.
    hybrid = RandomForestRegressor(**RF_PARAMS)
    hybrid.fit(train_df[HYBRID_FEATURES], train_df['PC_residual'])
    residual_pred = hybrid.predict(test_df[HYBRID_FEATURES])
    hybrid_pred = test_df['PC_delta_P'].to_numpy() + residual_pred

    return plain_pred, hybrid_pred, plain, hybrid


def run_pooled(d):
    train, test = train_test_split(d, test_size=0.20, random_state=42)
    pp, hp, _, _ = fit_models(train, test)
    rows = []
    for name, pred in [('PC baseline', test['PC_delta_P']), ('Plain RF', pp), ('Hybrid RF', hp)]:
        m = metrics(test[TARGET], pred)
        rows.append({'strategy': 'pooled_random_80_20', 'model': name, **m})
    return pd.DataFrame(rows)


def run_lowo(d):
    rows = []
    for well in d['Wellbore name'].unique():
        train = d[d['Wellbore name'] != well]
        test = d[d['Wellbore name'] == well]
        pp, hp, _, _ = fit_models(train, test)
        for name, pred in [('PC baseline', test['PC_delta_P']), ('Plain RF', pp), ('Hybrid RF', hp)]:
            m = metrics(test[TARGET], pred)
            rows.append({'strategy': 'LOWO', 'test_well': well, 'n_test': len(test), 'model': name, **m})
    return pd.DataFrame(rows)


def run_chronological(d):
    rows = []
    for well in d['Wellbore name'].unique():
        w = d[d['Wellbore name'] == well].sort_values('Date of Production')
        cut = int(len(w) * 0.70)
        train, test = w.iloc[:cut], w.iloc[cut:]
        pp, hp, _, _ = fit_models(train, test)
        for name, pred in [('PC baseline', test['PC_delta_P']), ('Plain RF', pp), ('Hybrid RF', hp)]:
            m = metrics(test[TARGET], pred)
            rows.append({'strategy': 'chronological_70_30', 'test_well': well, 'n_test': len(test), 'model': name, **m})
    return pd.DataFrame(rows)


def main():
    print('=' * 78)
    print('HYBRID POETTMANN-CARPENTER + RANDOM FOREST VLP PIPELINE')
    print('=' * 78)
    print('PC assumptions:', {
        'tubing_id_in': PC_TUBING_ID_IN,
        'depth_m': PC_DEPTH_M,
        'API': PC_API,
        'gas_SG': PC_GAS_SG,
        'water_SG': PC_WATER_SG,
        'segments': PC_SEGMENTS,
    })

    d = prepare_data()
    print(f'Final model-ready rows: {len(d)}')
    print(d['Wellbore name'].value_counts().to_string())
    d.to_csv(DATA_DIR / 'hybrid_model_ready.csv', index=False)

    pc_stats = pd.DataFrame([metrics(d[TARGET], d['PC_delta_P']) | {'model': 'PC baseline'}])
    pc_stats.to_csv(DATA_DIR / 'pc_baseline_overall.csv', index=False)

    pooled = run_pooled(d)
    lowo = run_lowo(d)
    chrono = run_chronological(d)

    pooled.to_csv(DATA_DIR / 'hybrid_pooled_results.csv', index=False)
    lowo.to_csv(DATA_DIR / 'hybrid_lowo_results.csv', index=False)
    chrono.to_csv(DATA_DIR / 'hybrid_chronological_results.csv', index=False)

    all_results = pd.concat([pooled, lowo, chrono], ignore_index=True)
    all_results.to_csv(DATA_DIR / 'hybrid_all_results.csv', index=False)

    print('\nPOOLED RANDOM SPLIT')
    print(pooled.round(4).to_string(index=False))
    print('\nLEAVE-ONE-WELL-OUT')
    print(lowo.round(4).to_string(index=False))
    print('\nCHRONOLOGICAL 70/30')
    print(chrono.round(4).to_string(index=False))

    print('\nSaved: hybrid_model_ready.csv, pc_baseline_overall.csv, hybrid_*_results.csv')
    print('NOTE: replace assumed PC geometry/PVT inputs with documented well-specific values before final submission.')


if __name__ == '__main__':
    main()
